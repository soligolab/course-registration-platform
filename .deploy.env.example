# Copia in .deploy.env (non versionato) e compila. Usato da scripts/deploy-lxc.sh.
DEPLOY_HOST=root@proxmox.example.lan     # host Proxmox, accesso ssh a chiave
DEPLOY_CT=100                            # id del container LXC
DEPLOY_DATASET=rpool/data/subvol-100-disk-0   # dataset ZFS del rootfs del container
DEPLOY_CHECK_URL=http://corsi.example.lan/    # facoltativo: verifica finale
