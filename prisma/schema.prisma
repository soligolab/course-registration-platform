generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                String           @id @default(cuid())
  email             String           @unique
  role              String           @default("CLIENT") // ADMIN | CLIENT
  locale            String           @default("it")
  firstName         String?
  lastName          String?
  age               Int?
  phone             String?
  guardianName      String?
  guardianConsentAt DateTime?
  emailVerifiedAt   DateTime?
  privacyAcceptedAt DateTime?
  privacyVersion    String?
  billingJson       String? // dati di fatturazione (JSON, vedi src/lib/billing.ts)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  sessions          Session[]
  requests          BookingRequest[]
}

model OtpCode {
  id         String    @id @default(cuid())
  email      String
  codeHash   String
  ip         String?
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email, createdAt])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Package {
  id                String           @id @default(cuid())
  nameIt            String
  nameEn            String
  descriptionIt     String           @default("")
  descriptionEn     String           @default("") // riassunto in testo semplice, nella scheda della home
  detailsIt         String           @default("") // descrizione completa in HTML (sanificato), nella pagina del corso
  detailsEn         String           @default("")
  totalSlots        Int // unità da SLOT_MINUTES (15 minuti)
  minLessonSlots    Int
  maxLessonSlots    Int
  lessonStepSlots   Int              @default(1) // ogni lezione dura un multiplo di questo blocco
  validityDays      Int
  maxLessonsPerWeek Int?
  active            Boolean          @default(true)
  sortOrder         Int              @default(0)
  imageUrl          String           @default("") // /presets/… o /media/…
  priceCents        Int? // prezzo del pacchetto; null = lezioni × tariffa (vedi src/lib/pricing.ts)
  kind              String           @default("PACKAGE") // PACKAGE | SINGLE: lezione singola di una durata del tariffario, gestita da src/lib/single-lessons.ts
  maxParticipants   Int              @default(1) // partecipanti per lezione: > 1 = lezioni di gruppo
  groupKey          String           @default("") // pacchetti con lo stesso gruppo e la stessa durata condividono le lezioni
  timeWindowsJson   String           @default("[]") // fasce settimanali [{ weekday 1-7, from, to }]; vuoto = tutta la disponibilità
  createdAt         DateTime         @default(now())
  requests          BookingRequest[]
  lessons           Lesson[]
}

model AvailabilitySlot {
  id      String   @id @default(cuid())
  startAt DateTime @unique
}

model BookingRequest {
  id         String       @id @default(cuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  packageId  String
  package    Package      @relation(fields: [packageId], references: [id])
  status     String       @default("PENDING") // PENDING | CONFIRMED | REJECTED | CANCELLED
  userNotes  String       @default("")
  adminNotes String       @default("")
  // copia degli slot richiesti (JSON di ISO string), conservata anche dopo rifiuto/annullamento
  slotsJson  String
  // prezzo indicativo al momento della richiesta (centesimi); null se il tariffario non era fissato
  priceCents Int?
  // copia dei dati di fatturazione al momento della richiesta
  billingJson String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  seats      Seat[]
}

/// Lezione fissata dal primo cliente che la prenota; altri clienti dello stesso gruppo possono occupare i posti liberi.
model Lesson {
  id        String       @id @default(cuid())
  packageId String
  package   Package      @relation(fields: [packageId], references: [id])
  startAt   DateTime
  slotCount Int
  createdAt DateTime     @default(now())
  slots     BookedSlot[]
  seats     Seat[]
}

/// Slot occupati dalle lezioni: startAt unique impedisce sovrapposizioni tra lezioni, di qualsiasi corso.
model BookedSlot {
  id       String   @id @default(cuid())
  lessonId String
  lesson   Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  startAt  DateTime @unique
}

/// Posto di una richiesta in una lezione: (lessonId, seat) unique impedisce di superare il massimo.
model Seat {
  id        String         @id @default(cuid())
  lessonId  String
  lesson    Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  requestId String
  request   BookingRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  seat      Int

  @@unique([lessonId, seat])
  @@unique([lessonId, requestId])
  @@index([requestId])
}

model Setting {
  key   String @id
  value String
}
