# URL pubblico del sito (usato nei link email e per i cookie "secure" se https)
APP_URL=http://localhost:3000

# Database SQLite (path relativo a prisma/schema.prisma)
DATABASE_URL=file:../data/app.db

# Segreto per l'hash dei codici OTP e delle sessioni: stringa casuale lunga
AUTH_SECRET=cambia-questa-stringa-con-una-casuale-lunga

# Opzionale: solo questa email può diventare amministratore al primo accesso.
# Se vuoto, il primo utente che si registra diventa admin.
ADMIN_EMAIL=

# SMTP (se SMTP_HOST è vuoto le email vengono solo stampate in console)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Corsi <noreply@example.com>"

# Immagini caricate dagli admin (logo, banner, pacchetti). Default: ./data/uploads
# UPLOAD_DIR=/percorso/uploads
